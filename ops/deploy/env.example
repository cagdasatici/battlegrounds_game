# Elemental Battlegrounds production environment. Copy to a file OUTSIDE the repository, chmod 600.
# Validated at startup by apps/server/src/config/env.ts; a bad value exits with code 78 and a nonsecret message.
NODE_ENV=production
HOST=127.0.0.1
PORT=2567
# Exact origin the browsers use (the HTTPS proxy address). No path, no trailing slash.
PUBLIC_ORIGIN=https://CHOOSE-A-HOSTNAME.example
ROOM_CAPACITY=4
# Absolute, owner-only (chmod 700) directory outside the repository. Holds sessions.json and invites.json.
DATA_DIR=/Users/SERVICE_ACCOUNT/eb-data
LOG_LEVEL=info
# Tagged commit, for example v0.1.0 or the short hash. Shown by /api/version.
BUILD_ID=CHANGE-ME
# Optional: STATIC_DIR=/absolute/path/to/apps/client/dist (default is the repository build)
